        "num = int(input(\"Enter a number: \"))\n",
        "\n",
        "temp = num\n",
        "reverse = 0\n",
        "\n",
        "while num > 0:\n",
        "    digit = num % 10\n",
        "    reverse = reverse * 10 + digit\n",
        "    num //= 10\n",
        "\n",
        "if temp == reverse:\n",
        "    print(\"Palindrome\")\n",
        "else:\n",
        "    print(\"Not a palindrome\")"
      ],
